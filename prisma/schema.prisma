generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TransactionType {
  INCOME
  EXPENSE
  TRANSFER
  REFUND
  ADJUSTMENT
}

enum TransactionDraftOrigin {
  QUICK
  PASTE
  EMAIL
}

enum TransactionDraftStatus {
  NEEDS_REVIEW
  READY
  IMPORTING
  IMPORTED
  DISMISSED
}

enum TransactionImportBatchStatus {
  IMPORTING
  IMPORTED
}

enum InboundMailboxProvider {
  RESEND
}

enum InboundMailboxStatus {
  ACTIVE
  DISABLED
}

enum InboundEmailReceiptState {
  RECEIVED
  PROCESSING
  PROCESSED
  IGNORED
  RETRYABLE_FAILED
  TERMINAL_FAILED
}

enum InboundEmailDisposition {
  TEST_DRAFT_CREATED
  DUPLICATE
  UNSUPPORTED
  OVERSIZED
  RATE_LIMITED
  PROVIDER_ERROR
  PARSER_ERROR
}

enum CategoryType {
  INCOME
  EXPENSE
  BOTH
  TRANSFER
  OTHER
}

enum QualityRating {
  S
  A
  B
  C
  D
}

enum MoneySourceType {
  CASH
  BANK_ACCOUNT
  CREDIT_CARD
  DEBIT_CARD
  E_WALLET
  INVESTMENT
  OTHER
}

enum ProjectStatus {
  ACTIVE
  COMPLETED
  PAUSED
}

enum GoalStatus {
  ACTIVE
  COMPLETED
  PAUSED
}

enum ContributionType {
  CONTRIBUTION
  WITHDRAWAL
}

enum RenewalStatus {
  ACTIVE
  PAUSED
  CANCELLED
}

enum RenewalFrequency {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
  CUSTOM
}

enum AdjustmentDirection {
  INCREASE
  DECREASE
}

enum AdjustmentTarget {
  CREDIT_CARD_DEBT
  CARD_CREDIT
}

enum CardNetwork {
  VISA
  MASTERCARD
  JCB
  NAPAS
  AMEX
  OTHER
}

enum FeeFrequency {
  YEARLY
  MONTHLY
  QUARTERLY
  CUSTOM
}

enum WaiverPeriod {
  YEARLY
  MONTHLY
  STATEMENT_CYCLE
  CUSTOM
}

model User {
  id                       String                   @id @default(cuid())
  email                    String                   @unique
  name                     String
  passwordHash             String
  createdAt                DateTime                 @default(now())
  updatedAt                DateTime                 @updatedAt
  categories               Category[]
  moneySources             MoneySource[]
  financialProjects        FinancialProject[]
  transactions             Transaction[]
  savingGoals              SavingGoal[]
  goalContributions        GoalContribution[]
  recurringPayments        RecurringPayment[]
  receiptUploads           ReceiptUpload[]
  activityLogs             ActivityLog[]
  transactionDrafts        TransactionDraft[]
  transactionImportBatches TransactionImportBatch[]
  inboundMailbox           InboundMailbox?
  inboundEmailReceipts     InboundEmailReceipt[]
  settings                 UserSettings?
}

model UserSettings {
  id                     String   @id @default(cuid())
  userId                 String   @unique
  defaultCurrency        String   @default("VND")
  dateFormat             String   @default("DD/MM/YYYY")
  numberFormat           String   @default("1,000,000")
  defaultDashboardPeriod String   @default("Month")
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  user                   User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Category {
  id                          String             @id @default(cuid())
  userId                      String
  name                        String
  type                        CategoryType
  color                       String?
  icon                        String?
  defaultQualityRating        QualityRating?
  defaultCountTowardFeeWaiver Boolean            @default(true)
  isDefault                   Boolean            @default(false)
  createdAt                   DateTime           @default(now())
  updatedAt                   DateTime           @updatedAt
  user                        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions                Transaction[]
  recurringPayments           RecurringPayment[]

  @@index([userId])
}

model MoneySource {
  id                         String             @id @default(cuid())
  userId                     String
  name                       String
  type                       MoneySourceType
  providerName               String?
  displayIdentifier          String?
  currency                   String             @default("VND")
  openingBalance             Decimal            @default(0) @db.Decimal(18, 2)
  description                String?
  isActive                   Boolean            @default(true)
  cardLastFourDigits         String?
  cardNetwork                CardNetwork?
  openedDate                 DateTime?
  creditLimit                Decimal?           @db.Decimal(18, 2)
  initialOutstandingDebt     Decimal            @default(0) @db.Decimal(18, 2)
  initialCardCredit          Decimal            @default(0) @db.Decimal(18, 2)
  billingCycleDay            Int?
  paymentDueDay              Int?
  hasAnnualFee               Boolean            @default(false)
  annualFeeAmount            Decimal?           @db.Decimal(18, 2)
  annualFeeCurrency          String             @default("VND")
  annualFeeChargeDate        DateTime?
  annualFeeFrequency         FeeFrequency?
  firstYearFeeWaived         Boolean            @default(false)
  freeYearsCount             Int?
  feeWaivedUntilDate         DateTime?
  annualFeeWaiverEnabled     Boolean            @default(false)
  annualFeeWaiverSpendTarget Decimal?           @db.Decimal(18, 2)
  annualFeeWaiverPeriod      WaiverPeriod?
  waiverPeriodStartDate      DateTime?
  waiverPeriodEndDate        DateTime?
  annualFeeWaiverNote        String?
  createdAt                  DateTime           @default(now())
  updatedAt                  DateTime           @updatedAt
  user                       User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  fromTransactions           Transaction[]      @relation("FromSource")
  toTransactions             Transaction[]      @relation("ToSource")
  adjustedTransactions       Transaction[]      @relation("AdjustedSource")
  goalContributions          GoalContribution[]
  renewalFromPayments        RecurringPayment[] @relation("RenewalFrom")
  renewalToPayments          RecurringPayment[] @relation("RenewalTo")

  @@index([userId])
}

model FinancialProject {
  id                String             @id @default(cuid())
  userId            String
  name              String
  description       String?
  status            ProjectStatus      @default(ACTIVE)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions      Transaction[]
  recurringPayments RecurringPayment[]

  @@index([userId])
}

model Transaction {
  id                    String               @id @default(cuid())
  userId                String
  type                  TransactionType
  amount                Decimal              @db.Decimal(18, 2)
  currency              String               @default("VND")
  title                 String
  description           String?
  transactionDate       DateTime
  categoryId            String?
  qualityRating         QualityRating?
  fromMoneySourceId     String?
  toMoneySourceId       String?
  adjustedMoneySourceId String?
  adjustmentDirection   AdjustmentDirection?
  adjustmentTarget      AdjustmentTarget?
  projectId             String?
  relatedTransactionId  String?
  countTowardFeeWaiver  Boolean              @default(false)
  recurringPaymentId    String?
  isInstallmentRelated  Boolean              @default(false)
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  user                  User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  category              Category?            @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  fromMoneySource       MoneySource?         @relation("FromSource", fields: [fromMoneySourceId], references: [id], onDelete: SetNull)
  toMoneySource         MoneySource?         @relation("ToSource", fields: [toMoneySourceId], references: [id], onDelete: SetNull)
  adjustedMoneySource   MoneySource?         @relation("AdjustedSource", fields: [adjustedMoneySourceId], references: [id], onDelete: SetNull)
  project               FinancialProject?    @relation(fields: [projectId], references: [id], onDelete: SetNull)
  relatedTransaction    Transaction?         @relation("RelatedTransactions", fields: [relatedTransactionId], references: [id], onDelete: SetNull)
  relatedTransactions   Transaction[]        @relation("RelatedTransactions")
  recurringPayment      RecurringPayment?    @relation(fields: [recurringPaymentId], references: [id], onDelete: SetNull)
  goalContributions     GoalContribution[]

  @@index([userId])
  @@index([categoryId])
  @@index([fromMoneySourceId])
  @@index([toMoneySourceId])
  @@index([adjustedMoneySourceId])
  @@index([projectId])
  @@index([relatedTransactionId])
  @@index([recurringPaymentId])
}

model SavingGoal {
  id                String             @id @default(cuid())
  userId            String
  name              String
  targetAmount      Decimal            @db.Decimal(18, 2)
  currency          String             @default("VND")
  deadline          DateTime?
  description       String?
  status            GoalStatus         @default(ACTIVE)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  goalContributions GoalContribution[]

  @@index([userId])
}

model GoalContribution {
  id                 String           @id @default(cuid())
  userId             String
  savingGoalId       String
  transactionId      String?
  fromMoneySourceId  String?
  amount             Decimal          @db.Decimal(18, 2)
  type               ContributionType
  isManualAdjustment Boolean          @default(false)
  note               String?
  contributionDate   DateTime
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  user               User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  savingGoal         SavingGoal       @relation(fields: [savingGoalId], references: [id], onDelete: Cascade)
  transaction        Transaction?     @relation(fields: [transactionId], references: [id], onDelete: SetNull)
  fromMoneySource    MoneySource?     @relation(fields: [fromMoneySourceId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([savingGoalId])
  @@index([transactionId])
  @@index([fromMoneySourceId])
}

model RecurringPayment {
  id                    String            @id @default(cuid())
  userId                String
  fromMoneySourceId     String?
  toMoneySourceId       String?
  categoryId            String?
  projectId             String?
  title                 String
  description           String?
  amount                Decimal           @db.Decimal(18, 2)
  currency              String            @default("VND")
  transactionType       TransactionType
  qualityRating         QualityRating?
  countTowardFeeWaiver  Boolean           @default(false)
  frequency             RenewalFrequency
  intervalCount         Int               @default(1)
  nextDueDate           DateTime
  reminderDaysBefore    Int               @default(3)
  autoCreateTransaction Boolean           @default(false)
  status                RenewalStatus     @default(ACTIVE)
  lastGeneratedDate     DateTime?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  user                  User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  fromMoneySource       MoneySource?      @relation("RenewalFrom", fields: [fromMoneySourceId], references: [id], onDelete: SetNull)
  toMoneySource         MoneySource?      @relation("RenewalTo", fields: [toMoneySourceId], references: [id], onDelete: SetNull)
  category              Category?         @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  project               FinancialProject? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  generatedTransactions Transaction[]

  @@index([userId])
  @@index([fromMoneySourceId])
  @@index([toMoneySourceId])
  @@index([categoryId])
  @@index([projectId])
}

model ReceiptUpload {
  id            String   @id @default(cuid())
  userId        String
  fileUrl       String
  extractedData Json?
  status        String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model ActivityLog {
  id         String   @id @default(cuid())
  userId     String
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}

model TransactionDraft {
  id                               String                  @id @default(cuid())
  userId                           String
  captureKey                       String
  position                         Int
  origin                           TransactionDraftOrigin
  status                           TransactionDraftStatus  @default(NEEDS_REVIEW)
  confidence                       Int?
  type                             TransactionType?
  amountText                       String?
  currency                         String?
  title                            String?
  description                      String?
  transactionDateText              String?
  categoryId                       String?
  qualityRating                    QualityRating?
  fromMoneySourceId                String?
  toMoneySourceId                  String?
  adjustedMoneySourceId            String?
  adjustmentDirection              AdjustmentDirection?
  adjustmentTarget                 AdjustmentTarget?
  projectId                        String?
  relatedTransactionId             String?
  countTowardFeeWaiver             Boolean?
  countTowardFeeWaiverTouched      Boolean                 @default(false)
  qualityRatingTouched             Boolean                 @default(false)
  recurringPaymentId               String?
  isInstallmentRelated             Boolean                 @default(false)
  duplicateFingerprint             String?
  duplicateConfirmed               Boolean                 @default(false)
  duplicateAcknowledgementRequired Boolean                 @default(false)
  invalidMappedFields              Json                    @default("[]")
  validationIssues                 Json                    @default("[]")
  rawRow                           Json?
  importBatchId                    String?
  importedTransactionId            String?
  inboundEmailReceiptId            String?                 @unique
  expiresAt                        DateTime
  createdAt                        DateTime                @default(now())
  updatedAt                        DateTime                @updatedAt
  user                             User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  importBatch                      TransactionImportBatch? @relation(fields: [importBatchId], references: [id], onDelete: SetNull)
  inboundEmailReceipt              InboundEmailReceipt?    @relation(fields: [inboundEmailReceiptId], references: [id], onDelete: SetNull)

  @@unique([userId, captureKey, position])
  @@index([userId, status])
  @@index([userId, captureKey, duplicateFingerprint])
  @@index([importBatchId])
  @@index([expiresAt])
}

model TransactionImportBatch {
  id             String                       @id @default(cuid())
  userId         String
  idempotencyKey String
  origin         TransactionDraftOrigin
  status         TransactionImportBatchStatus @default(IMPORTING)
  draftIds       Json                         @default("[]")
  transactionIds Json                         @default("[]")
  createdAt      DateTime                     @default(now())
  updatedAt      DateTime                     @updatedAt
  user           User                         @relation(fields: [userId], references: [id], onDelete: Cascade)
  drafts         TransactionDraft[]

  @@unique([userId, idempotencyKey])
  @@index([userId, createdAt])
}

model InboundMailbox {
  id                String                    @id @default(cuid())
  userId            String                    @unique
  provider          InboundMailboxProvider    @default(RESEND)
  aliasLocalPart    String                    @unique @db.VarChar(64)
  status            InboundMailboxStatus      @default(ACTIVE)
  lastDisposition   InboundEmailDisposition?
  lastReceivedAt    DateTime?
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt
  user              User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  receipts          InboundEmailReceipt[]

  @@index([status])
}

model InboundEmailReceipt {
  id                  String                   @id @default(cuid())
  userId              String
  mailboxId           String
  providerEventHash   String                   @unique @db.Char(64)
  providerMessageHash String                   @db.Char(64)
  state               InboundEmailReceiptState @default(RECEIVED)
  disposition         InboundEmailDisposition?
  attemptCount        Int                      @default(0)
  expiresAt           DateTime
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt
  user                User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  mailbox             InboundMailbox           @relation(fields: [mailboxId], references: [id], onDelete: Cascade)
  draft               TransactionDraft?

  @@unique([mailboxId, providerMessageHash])
  @@index([userId, state])
  @@index([expiresAt])
}

model RateLimitBucket {
  scope          String
  identifierHash String
  windowStart    DateTime
  count          Int      @default(0)
  expiresAt      DateTime
  createdAt      DateTime @default(now())

  @@id([scope, identifierHash, windowStart])
  @@index([expiresAt])
  @@map("rate_limit_buckets")
}
